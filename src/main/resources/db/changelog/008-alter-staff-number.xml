<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="008-alter-staff-number" author="alif">
        <addColumn tableName="staff">
            <column name="staff_number" type="VARCHAR(100)"/>
        </addColumn>

        <addNotNullConstraint
                tableName="staff"
                columnName="staff_number"
                columnDataType="VARCHAR(100)"/>

        <addUniqueConstraint
                tableName="staff"
                columnNames="staff_number"
                constraintName="uk_staff_staff_number"/>

        <createIndex
                tableName="staff"
                indexName="idx_staff_staff_number">
            <column name="staff_number"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>