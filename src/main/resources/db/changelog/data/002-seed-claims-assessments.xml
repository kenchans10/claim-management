<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-seed-claims-assessments" author="alif">

        <!-- Seed claims -->
        <insert tableName="claims">
            <column name="id" value="55555555-5555-5555-5555-555555555555"/>
            <column name="claim_number" value="CLM-ABC12345"/>
            <column name="claimant_id" value="11111111-1111-1111-1111-111111111111"/>
            <column name="claim_type" value="MOTOR"/>
            <column name="status" value="APPROVED"/>
            <column name="description"
                    value="Car accident on Main Street involving two vehicles"/>
            <column name="created_at"
                    valueDate="2024-01-15T10:30:00"/>
            <column name="updated_at"
                    valueDate="2024-01-15T12:15:00"/>
            <column name="version" valueNumeric="1"/>
        </insert>

        <!-- Seed assessments -->
        <insert tableName="assessments">
            <column name="id" value="66666666-6666-6666-6666-666666666666"/>
            <column name="claim_id"
                    value="55555555-5555-5555-5555-555555555555"/>
            <column name="staff_id"
                    value="33333333-3333-3333-3333-333333333333"/>
            <column name="assessment_type" value="INITIAL_REVIEW"/>
            <column name="description"
                    value="Initial assessment completed. Claim is valid and within policy terms."/>
            <column name="details"
                    value="All documentation provided. No red flags identified."/>
            <column name="estimated_amount" valueNumeric="5000.00"/>
            <column name="settled_amount" valueNumeric="4800.00"/>
            <column name="result" value="APPROVED"/>
            <column name="created_at"
                    valueDate="2024-01-15T11:30:00"/>
            <column name="updated_at"
                    valueDate="2024-01-15T12:15:00"/>
            <column name="version" valueNumeric="0"/>
        </insert>

    </changeSet>

</databaseChangeLog>
