<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="005-create-staff-claim-queue-table" author="alif">

        <createTable tableName="staff_claim_queue">

            <column name="id" type="UUID">
                <constraints primaryKey="true"
                             primaryKeyName="pk_staff_claim_queue"
                             nullable="false"/>
            </column>

            <column name="claim_id" type="UUID">
                <constraints nullable="false"
                             unique="true"
                             uniqueConstraintName="uk_staff_claim_queue_claim_id"/>
            </column>

            <column name="staff_id" type="UUID"/>

            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="queued_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="picked_up_at" type="TIMESTAMP"/>

        </createTable>

        <!-- Foreign key: staff_claim_queue -> claims -->
        <addForeignKeyConstraint
                baseTableName="staff_claim_queue"
                baseColumnNames="claim_id"
                constraintName="fk_staff_claim_queue_claims"
                referencedTableName="claims"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <!-- Foreign key: staff_claim_queue -> staff -->
        <addForeignKeyConstraint
                baseTableName="staff_claim_queue"
                baseColumnNames="staff_id"
                constraintName="fk_staff_claim_queue_staff"
                referencedTableName="staff"
                referencedColumnNames="id"
                onDelete="RESTRICT"/>

    </changeSet>
</databaseChangeLog>