<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-claimants-table" author="alif">
        <createTable tableName="claimants">

            <column name="id" type="UUID">
                <constraints primaryKey="true"
                             primaryKeyName="pk_claimants"
                             nullable="false"/>
            </column>

            <column name="claimant_member_number" type="VARCHAR(100)">
                <constraints nullable="false"
                             unique="true"
                             uniqueConstraintName="uk_claimants_member_number"/>
            </column>

            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="last_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="phone" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="address" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>

            <column name="policy_number" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

        </createTable>
    </changeSet>
</databaseChangeLog>